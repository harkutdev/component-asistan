          { "pin": 3, "name": "VI", "function": "Input — Regüle edilmemiş giriş voltajı" }
        ]
      },
      "thermalResistance": "4°C/W (heatsink ile)",
      "operatingTemperature": "0°C ~ +125°C",
      "formula": "Vout = 1.25V × (1 + R2/R1) + (Iadj × R2)"
